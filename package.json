{
  "name": "@nzlov/dsh-bing-wallpaper",
  "version": "1.9.0",
  "type": "module",
  "description": "Daily Bing wallpaper, image-derived theme colours and automatic day/night appearance for DSH Web.",
  "author": "nzlov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nzlov/dsh-bing-wallpaper.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "exports": {
    ".": "./src/server/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "src/server",
    "src/shared",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "assets/icon.svg",
    "LICENSE",
    "third-party"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
